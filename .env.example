# euler-verifier environment (TypeScript engine)
#
# For team runs, secrets come from Doppler: run `./script/dopplerLogin.sh` once,
# then `./script/dopplerSync.sh` (project "euler-verifier", config "prd") to
# write this file. Everything below is OPTIONAL: the chains that ship a public
# default RPC in networks.json verify with no env at all. Set a value only to
# override a public default or to reach a chain that has none.

# --- Explorer cross-check (optional) -----------------------------------------
# The explorer check is a SECONDARY, untrusted signal shown in reports; it never
# affects the verdict. One Etherscan v2 key covers every etherscan_v2 chain in
# networks.json.
ETHERSCAN_API_KEY=

# Per-chain explorer overrides. These take precedence over ETHERSCAN_API_KEY and
# over the "explorer_api" base URL in networks.json. Example (Sonic, chain 146):
# VERIFIER_URL_146=
# VERIFIER_API_KEY_146=

# --- RPC endpoints -----------------------------------------------------------
# DEPLOYMENT_RPC_URL_<chainId> overrides the RPC for that chain and takes
# precedence over the public defaults in networks.json. Leave blank to use the
# public default.
DEPLOYMENT_RPC_URL_1=        # Ethereum Mainnet
DEPLOYMENT_RPC_URL_10=       # Optimism
DEPLOYMENT_RPC_URL_56=       # BSC
DEPLOYMENT_RPC_URL_100=      # Gnosis
DEPLOYMENT_RPC_URL_130=      # Unichain
DEPLOYMENT_RPC_URL_137=      # Polygon
DEPLOYMENT_RPC_URL_143=      # Monad
DEPLOYMENT_RPC_URL_146=      # Sonic
DEPLOYMENT_RPC_URL_239=      # TAC
DEPLOYMENT_RPC_URL_1923=     # Swell
DEPLOYMENT_RPC_URL_2818=     # Morph
DEPLOYMENT_RPC_URL_8453=     # Base
DEPLOYMENT_RPC_URL_9745=     # Plasma
DEPLOYMENT_RPC_URL_42161=    # Arbitrum
DEPLOYMENT_RPC_URL_43114=    # Avalanche
DEPLOYMENT_RPC_URL_59144=    # Linea
DEPLOYMENT_RPC_URL_60808=    # BOB
DEPLOYMENT_RPC_URL_80094=    # Berachain
